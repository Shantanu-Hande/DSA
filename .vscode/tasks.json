{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile and Run Current Java File",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "javac \"${file}\" && java -cp \"${fileDirname}\" \"${fileBasenameNoExtension}\" < \"${workspaceFolder}\\input.txt\" > \"${workspaceFolder}\\output.txt\""
            ],
            "presentation": {
                "reveal": "never"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$javac"
            ]
        }
    ]
}